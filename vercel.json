{
  "buildCommand": "cd code/client && npm install --legacy-peer-deps --no-audit --no-fund && CI=false npm run build",
  "outputDirectory": "code/client/build",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/user/(.*)", "destination": "/api/index.js" },
    { "source": "/city/(.*)", "destination": "/api/index.js" },
    { "source": "/bus/(.*)", "destination": "/api/index.js" },
    { "source": "/order/(.*)", "destination": "/api/index.js" },
    { "source": "/ai/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
