{
  "buildCommand": "cd code/client && npm install --legacy-peer-deps --no-audit --no-fund && CI=false npm run build",
  "outputDirectory": "code/client/build",
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api" },
    { "source": "/user/:match*", "destination": "/api" },
    { "source": "/city/:match*", "destination": "/api" },
    { "source": "/bus/:match*", "destination": "/api" },
    { "source": "/order/:match*", "destination": "/api" },
    { "source": "/ai/:match*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/((?!api|user|city|bus|order|ai|health).*)", "destination": "/index.html" }
  ]
}
